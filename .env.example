# Server-side API origin. Configure Preview and Production independently.
TERRALA_API_URL=
# Public Blob store origin; contains the assets/ prefix (no path in this value).
TERRALA_ASSET_URL=
# Optional canonical frontend origin. Do not reuse production origin in Preview.
TERRALA_SITE_ORIGIN=
TERRALA_MESSENGER_URL=
TERRALA_ZALO_URL=
# Optional, only for the legacy FE admin request page:
TERRALA_GOOGLE_CLIENT_ID=
# Optional server-only secret for calling a Vercel-protected BE Preview.
TERRALA_API_BYPASS_SECRET=
