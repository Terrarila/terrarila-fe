{
  "name": "terrala-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:logic && npm run test:unit",
    "test:logic": "node --experimental-strip-types --test tests/*.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@reduxjs/toolkit": "^2.13.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "engines": {
    "node": "24.x"
  }
}
